# =======================================================================
# Peter Air Systems - Apache 301 Permanent Redirect Configuration
# Preserves Google Search Rankings, SEO Link Equity, and Canonical URLs
# =======================================================================
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# -----------------------------------------------------------------------
# 1. WordPress System Feeds, Comments & Author Feeds
# -----------------------------------------------------------------------
RewriteRule ^feed/?$ /blog/ [R=301,L]
RewriteRule ^comments/feed/?$ /blog/ [R=301,L]
RewriteRule ^author/admin/feed/?$ /blog/ [R=301,L]

# -----------------------------------------------------------------------
# 2. WordPress Category & Tag Archives
# -----------------------------------------------------------------------
RewriteRule ^category/.*$ /blog/ [R=301,L]
RewriteRule ^tag/.*$ /blog/ [R=301,L]

# -----------------------------------------------------------------------
# 3. Legacy Page & Non-Matching Post Redirects
# -----------------------------------------------------------------------
RewriteRule ^about-us-new/?$ /about-us-peter-air-systems/ [R=301,L]
RewriteRule ^about/?$ /about-us-peter-air-systems/ [R=301,L]
RewriteRule ^contact/?$ /contact-peter-air-systems/ [R=301,L]
RewriteRule ^return-air-riser-2/?$ /return-air-riser/ [R=301,L]
RewriteRule ^other-products-laboratory-equipment/?$ /clean-room-equipment/ [R=301,L]
RewriteRule ^how-to-calculate-ahu-capacity-for-cleanrooms-and-industrial-facilities/?$ /air-handling-unit-ahu/ [R=301,L]
RewriteRule ^how-to-select-the-right-air-handling-unit-for-a-pharmaceutical-cleanroom/?$ /air-handling-unit-ahu/ [R=301,L]
RewriteRule ^how-to-choose-the-right-cleanroom-doors-for-pharmaceutical-facilities/?$ /modular-clean-room-doors/ [R=301,L]
RewriteRule ^complete-guide-to-contamination-control-systems-in-cleanrooms/?$ /clean-room-equipment/ [R=301,L]

# -----------------------------------------------------------------------
# 4. Strip /feed/ Suffix from Content URLs
# -----------------------------------------------------------------------
RewriteRule ^(.+)/feed/?$ /$1/ [R=301,L]

# -----------------------------------------------------------------------
# 5. 301 Permanent Redirects: Old Root Blog URLs -> /blog/{slug}/
# -----------------------------------------------------------------------
