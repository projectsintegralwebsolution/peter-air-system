# ==============================================================================
# Peter Air Systems - Backend & CMS Environment Configuration
# ==============================================================================

# Database Connection:
# Default: SQLite file (local development & small-scale self-hosted servers)
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example (Supabase, Neon, Railway, RDS):
# DATABASE_URL="postgresql://username:password@db.example.com:5432/peterair?schema=public&sslmode=require"

# Admin Authentication Secret (Generate a strong 32+ character random string in production)
JWT_SECRET="replace-with-a-cryptographically-secure-random-key"

# Initial Admin Account (Seeded automatically on first boot if no admin exists)
ADMIN_DEFAULT_EMAIL="admin@peterairs.com"
ADMIN_DEFAULT_PASSWORD="ChangeThisPasswordImmediately123!"

# Public Site URL (Used for sitemaps, canonical tags, and Open Graph previews)
NEXT_PUBLIC_SITE_URL="https://peterairs.com"

# ------------------------------------------------------------------------------
# 3-Way Email Notification (Nodemailer via Gmail SMTP)
# ------------------------------------------------------------------------------
# Host & Port: smtp.gmail.com (SSL Port 465)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true

# Sender Google Account (Used to send out all notifications)
SMTP_USER="integralwebsolution@gmail.com"

# Google App Password (Generate at: https://myaccount.google.com/apppasswords)
# Enter the 16-character generated password without spaces
SMTP_PASS="your-16-char-google-app-password"

# Destination Inboxes
SALES_EMAIL="sales@peterairs.com"
ADMIN_BACKUP_EMAIL="integralwebsolution@gmail.com"

