# ==============================================================================
# Peter Air Systems - Backend & CMS Environment Configuration
# ==============================================================================

# Database Connection:
# Pure JSON Database (data/json-db/) is used by default.
# Optional compatibility connection string:
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret (Generate a strong 32+ character random string in production)
JWT_SECRET="replace-with-a-cryptographically-secure-random-key"

# Initial Admin Account (Seeded automatically on first boot if no admin exists)
ADMIN_DEFAULT_EMAIL="admin@peterairs.com"
ADMIN_DEFAULT_PASSWORD="ChangeThisPasswordImmediately123!"

# Public Site URL (Used for sitemaps, canonical tags, and Open Graph previews)
NEXT_PUBLIC_SITE_URL="https://peterairs.com"

# ==============================================================================
# Three-Way Email Notification System (Nodemailer / SMTP)
# ==============================================================================
# Triggered automatically whenever a customer submits an enquiry form:
# 1. Customer Confirmation -> Customer's submitted email
# 2. Owner Notification    -> sanjay@peterairs.com
# 3. Admin Notification    -> princekumarjha80@gmail.com
#
# SMTP Server Settings (Example shown below for Gmail, or use your corporate webmail / SES):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM_NAME="Peter Air Systems"

# Notification Recipient Overrides (Optional - defaults are built-in):
OWNER_EMAIL="sanjay@peterairs.com"
ADMIN_EMAIL="princekumarjha80@gmail.com"
